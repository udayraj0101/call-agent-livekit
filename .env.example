# Copy this file to `.env` on the VPS and fill in real values.
# `.env` is gitignored — never commit it.

# ============================================================================
# Required for agent.py (production Cartesia/OpenAI/Deepgram build)
# ============================================================================

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI (LLM)
OPENAI_API_KEY=

# Deepgram (STT)
DEEPGRAM_API_KEY=

# Cartesia (TTS) — keep TTS_PROVIDER=cartesia for production
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=

# ============================================================================
# Optional — transfer_to_human tool (leave blank to disable)
# ============================================================================
SIP_TRANSFER_DOMAIN=
DEFAULT_TRANSFER_NUMBER=

# ============================================================================
# Optional — only if you run gemini_agent.py instead of agent.py
# ============================================================================
GEMINI_API_KEY=

# ============================================================================
# Optional — only if you run azure_agent.py instead of agent.py
# ============================================================================
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_VERSION=2024-10-21
